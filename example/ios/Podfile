# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# use_modular_headers!

target 'yourGPTWidgetSdkReactNative' do
  config = use_native_modules!

   # Your pods...
  # pod 'Firebase/Messaging'
  # ...

  # Firebase Swift/static linking requires module maps for these pods.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  # Enable modular headers so Swift can `canImport(RNCPushNotificationIOS)`
  pod 'RNCPushNotificationIOS', :path => '../node_modules/@react-native-community/push-notification-ios', :modular_headers => true

  # push-notification-ios is auto-linked via use_native_modules! after
  # running: yarn add @react-native-community/push-notification-ios
  # Then enable push notifications capability in Xcode and add GoogleService-Info.plist

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Workaround for Xcode 26.4+ (Apple Clang 21): fmt 11.x fails with
    # "call to consteval function ... is not a constant expression".
    # Building only the fmt pod as C++17 skips the consteval code path.
    # Fixed upstream in fmt 12.1.0 (React Native >= 0.83.9); remove this
    # after upgrading React Native.
    # https://github.com/facebook/react-native/issues/55601
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |build_config|
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
